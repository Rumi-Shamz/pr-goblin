{
  "name": "pr-goblin-intake",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:node": "esbuild src/node.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/node.mjs",
    "start": "node dist/node.mjs",
    "build:lib": "esbuild src/lib.ts --bundle --platform=neutral --format=esm --target=es2022 --main-fields=module,main --outfile=dist/pr-goblin-intake.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.124.0"
  },
  "packageManager": "pnpm@11.1.2",
  "dependencies": {
    "zod": "^4.6.7"
  }
}
