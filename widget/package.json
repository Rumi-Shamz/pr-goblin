{
  "name": "pr-goblin-widget",
  "version": "1.3.1",
  "description": "Drop-in feedback and bug-capture widget with AI-powered triage",
  "type": "module",
  "main": "./dist/pr-goblin.umd.js",
  "module": "./dist/pr-goblin.es.js",
  "exports": {
    ".": {
      "import": "./dist/pr-goblin.es.js",
      "require": "./dist/pr-goblin.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "bug-report",
    "feedback-widget",
    "github-issues"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.1.2"
}
