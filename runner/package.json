{
  "name": "pr-goblin",
  "version": "0.1.0",
  "type": "module",
  "description": "pr-goblin runner: polls Linear or GitHub Issues and turns tickets into pull requests using isolated coding agents",
  "main": "./src/index.ts",
  "bin": {
    "goblin": "./src/cli/app.ts"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/test-helpers.ts",
    "!src/e2e/",
    "skills/",
    "tsconfig.json"
  ],
  "scripts": {
    "start": "bun src/cli/app.ts start",
    "run": "bun src/cli/app.ts run",
    "once": "bun src/cli/app.ts once",
    "test": "bun test src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "cac": "^7.0.0",
    "graphql": "^16.13.1",
    "hono": "^4.12.12",
    "ora": "^9.3.0",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.3.0",
    "@types/bun": "latest",
    "typescript": "^5.8.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "orchestration",
    "daemon",
    "linear",
    "coding-agent",
    "automation"
  ],
  "private": true
}
